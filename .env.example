# Copy to .env or export before running run-portal.sh.
# All values are placeholders — override with your own deployment values.
NODE_ENV=production
DOMAIN=example.com
PORTAL_ORIGIN=https://example.com
INSTANCE_DOMAIN=example.com
INSTANCE_SLUG_SUFFIX=-deepseek
COOKIE_DOMAIN=
PORT=8080

# Seeded admin (first boot only). Password must be explicit, non-placeholder,
# and at least 16 characters; it is not required after an admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=admin
ADMIN_PASSWORD=

# Email / OTP. Production requires SMTP. For localhost-only development, set
# NODE_ENV=development, DOMAIN=localhost, PORTAL_ORIGIN=http://localhost:8080,
# and OTP_DEV_MODE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTP_DEV_MODE=false

INSTANCE_CPUS=2
INSTANCE_MEMORY=2g
INSTANCE_IDLE_TIMEOUT_MS=900000
INSTANCE_IDLE_SWEEP_INTERVAL_MS=60000
PORT_RANGE_START=18000
PORT_RANGE_END=18100
INSTANCE_START_TIMEOUT_MS=180000
