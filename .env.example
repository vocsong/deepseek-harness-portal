# Copy to .env or export before running run-portal.sh.
# All values are placeholders — override with your own deployment values.
DOMAIN=example.com
INSTANCE_DOMAIN=example.com
INSTANCE_SLUG_SUFFIX=-deepseek
COOKIE_DOMAIN=
PORT=8080

# Seeded admin (first boot only).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=admin
ADMIN_PASSWORD=changeme

# Email / OTP. Leave SMTP_HOST empty to log OTP codes to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# OTP_DEV_MODE=true

INSTANCE_CPUS=2
INSTANCE_MEMORY=2g
INSTANCE_IDLE_TIMEOUT_MS=900000
INSTANCE_IDLE_SWEEP_INTERVAL_MS=60000
PORT_RANGE_START=18000
PORT_RANGE_END=18100
INSTANCE_START_TIMEOUT_MS=180000
